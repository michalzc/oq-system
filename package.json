{
  "private": true,
  "name": "fvtt-system-oq",
  "version": "0.0.0",
  "description": "OpenQuest SRD system for Foundry VTT",
  "license": "WTFPL",
  "homepage": "https://github.com/michalzc/oq-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalzc/oq-system.git"
  },
  "bugs": {
    "url": "https://github.com/michalzc/oq-system/issues"
  },
  "contributors": [
    {
      "name": "Michał Z.",
      "email": "parmezan@gmail.com"
    }
  ],
  "type": "module",
  "scripts": {
    "lint": "yarn lint:js && yarn lint:styles && yarn lint:templates",
    "lint:js": "eslint \"**/*.{js,cjs,mjs}\" --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.less\" --max-warnings 0",
    "lint:templates": "eslint \"src/public/**/*.{hbs,handlebars,html}\" --max-warnings 0",
    "lint:fix": "yarn lint:js --fix && yarn lint:templates --fix && yarn lint:styles",
    "build:packs": "node tools/build-packs.mjs",
    "build:code": "vite build",
    "build": "yarn build:packs && yarn build:code",
    "dev": "vite build --watch",
    "clean": "node tools/clean.mjs",
    "test": "mocha",
    "build:watch": "vite build --watch",
    "format": "prettier --write \"./**/*.(js|cjs|mjs|json|yml|less)\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^1.0.4",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expect.js": "^0.3.1",
    "globals": "^17.13.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "less": "^3.13.1",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.1",
    "stylelint": "^16.1.0",
    "stylelint-config-recommended-less": "^3.0.1",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "*.(js|cjs|mjs)": "eslint --fix",
    "*.(less)": "stylelint",
    "*.(json|yml|less)": "prettier --write"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  }
}
