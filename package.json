{
  "private": true,
  "name": "fvtt-system-oq",
  "version": "0.0.0",
  "description": "<description of the package>",
  "license": "WTFPL",
  "homepage": "https://github.com/michalzc/oq-system/",
  "repository": {
    "type": "git",
    "url": "<optionally the URL to your repository>"
  },
  "bugs": {
    "url": "https://github.com/michalzc/oq-system/issues"
  },
  "contributors": [
    {
      "name": "Michał Z.",
      "email": "parmezan@gmail.com"
    }
  ],
  "type": "module",
  "scripts": {
    "lint": "yarn lint:js && yarn lint:styles && yarn lint:templates",
    "lint:js": "eslint --ext .js,.cjs,.mjs . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.less\" --max-warnings 0",
    "lint:templates": "ESLINT_USE_FLAT_CONFIG=true eslint --config tools/eslint-templates.config.mjs \"src/public/**/*.{hbs,handlebars,html}\" --max-warnings 0",
    "lint:fix": "yarn lint:js --fix && yarn lint:templates --fix && yarn lint:styles",
    "build:packs": "node tools/build-packs.mjs",
    "build:code": "vite build",
    "build": "yarn build:packs && yarn build:code",
    "dev": "vite build --watch",
    "clean": "node tools/clean.mjs",
    "test": "mocha",
    "build:watch": "vite build --watch",
    "format": "prettier --write \"./**/*.(js|cjs|mjs|json|yml|less)\"",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.4",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "expect.js": "^0.3.1",
    "handlebars": "^4.7.9",
    "husky": "^8.0.3",
    "js-yaml": "^4.1.0",
    "less": "^3.13.1",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.1",
    "stylelint": "^16.1.0",
    "stylelint-config-recommended-less": "^3.0.1",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "*.(js|cjs|mjs)": "eslint --fix",
    "*.(less)": "stylelint",
    "*.(json|yml|less)": "prettier --write"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  }
}
