  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "lint": "eslint --ext .js,.cjs,.mjs .; stylelint '**/*.less'",
    "lint:fix": "eslint --ext .js,.cjs,.mjs --fix .",
    "format": "prettier --write \"./**/*.(js|cjs|mjs|json|yml|less)\"",
    "postinstall": "husky install",
    "test": "mocha"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.4",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "expect.js": "^0.3.1",
    "husky": "^8.0.3",
    "js-yaml": "^4.1.0",
    "less": "^3.13.1",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.1",
    "stylelint": "^16.1.0",
    "stylelint-config-recommended-less": "^3.0.1",
    "stylelint-config-standard-less": "^3.0.1",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "*.(js|cjs|mjs)": "eslint --fix",
    "*.(less)": "stylelint",
    "*.(json|yml|less)": "prettier --write"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  }
}
