<div class="actor-sheet character-sheet flexcol">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" {{#if editable}}data-action="editImage"{{/if}} data-edit="img" title="{{actor.name}}" width="64" height="64"
         alt="{{actor.name}}">
    <div class="flexcol header-fields">
      <input class="name" type="text" data-dtype="String" name="name" value="{{actor.name}}"
             placeholder="{{ localize 'OQ.Labels.Name' }}">
      <div class="flexrow">
        <div class="flex1 flex-row-no-wrap">
          <label for="{{rootId}}-gender">{{ localize 'OQ.Labels.Gender' }}</label>
          <input class="small" type="text" data-dtype="String" id="{{rootId}}-gender" name="system.personal.gender"
                 value="{{system.personal.gender}}">
        </div>
        <div class="flex1 flex-row-no-wrap">
          <label for="{{rootId}}-age">{{ localize 'OQ.Labels.Age' }}</label>
          <input class="small" type="number" data-dtype="Number" id="{{rootId}}-age" name="system.personal.age"
                 value="{{system.personal.age}}">
        </div>
        <div class="flex2 flex-row-no-wrap">
          <label for="{{rootId}}-culture">{{ localize 'OQ.Labels.Culture' }}</label>
          <input type="text" data-dtype="String" id="{{rootId}}-culture" name="system.personal.culture"
                 value="{{system.personal.culture}}">
        </div>
      </div>

      <div class="flexrow">
        <div class="flex1 flex-row-no-wrap">
          <label for="{{rootId}}-rank">{{ localize 'OQ.Labels.Rank' }}</label>
          <input type="text" data-dtype="String" id="{{rootId}}-rank" name="system.personal.rank"
                 value="{{system.personal.rank}}">
        </div>
        <div class="flex1 flex-row-no-wrap">
          <label for="{{rootId}}-organisation">{{ localize 'OQ.Labels.Organisation' }}</label>
          <input type="text" data-dtype="String" id="{{rootId}}-organisation" name="system.personal.organisation"
                 value="{{system.personal.organisation}}">
        </div>
      </div>
      <div class="flexrow">
        <div class="flex1 flex-row-no-wrap">
          <label for="{{rootId}}-concept">{{ localize 'OQ.Labels.Concept' }}</label>
          <input type="text" data-dtype="String" id="{{rootId}}-concept" name="system.personal.concept"
                 value="{{system.personal.concept}}">
        </div>
      </div>
    </div>
  </header>
  <section class="sheet-body">

    <!-- characteristics -->
    <div class="characteristics">
      <h2 class="flex0">{{ localize 'OQ.Labels.Characteristics' }}</h2>

      <div class="flex1 flexrow">
        {{#each characteristics as |char key| }}
          <div class="flexcol characteristic">
            <label data-tooltip="{{ localize char.label }}" class="flex0">{{ localize char.abbr }}</label>
            <div data-tooltip="{{ localize char.label }}" class="characteristic-value flex0">{{char.value}}</div>
          </div>
        {{/each}}
        {{#if editable}}
          <a class="modify-characteristics flex0" data-action="modifyCharacteristics"
             data-tooltip="{{ localize 'OQ.Labels.EditCharacteristics' }}"><i class="fas fa-gear"></i></a>
        {{/if}}
      </div>

    </div>

    {{> systems/oq/templates/actor/parts/attributes.hbs this}}


  </section>

  <nav class="sheet-tabs tabs">
    {{#each tabs as |tab|}}
      <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
        {{localize tab.label}}
      </a>
    {{/each}}
  </nav>

  <section class="sheet-content">
    <div class="tab {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
      {{> systems/oq/templates/actor/parts/skills.hbs this}}
    </div>

    <div class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
      {{> systems/oq/templates/actor/parts/combat.hbs this}}
    </div>

    <div class="tab {{tabs.equipment.cssClass}}" data-group="primary" data-tab="equipment">
      {{> systems/oq/templates/actor/parts/equipment-list.hbs this}}
    </div>

    <div class="tab {{tabs.magic.cssClass}}" data-group="primary" data-tab="magic">
      {{> systems/oq/templates/actor/parts/magic.hbs this}}
    </div>

    <div class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">
      {{> systems/oq/templates/actor/parts/notes.hbs this}}
    </div>
  </section>
  <section class="sheet-footer">
    <div class="sheet-hint">{{ localize 'OQ.Hints.ItemRollHint' }}</div>
  </section>
</div>
