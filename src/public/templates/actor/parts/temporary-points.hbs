{{!-- A resource's available temporary points ("+N") and the control opening its pool editor. --}}
{{#if temporary}}
  <div class="temporary-points" data-tooltip="{{ localize 'OQ.Resources.TemporaryPoints' amount=temporary }}">
    +{{temporary}}</div>
{{/if}}
{{#if editable}}
  <a class="edit-temporary-points" data-action="editTemporaryPoints" data-resource-id="{{resource}}"
     data-tooltip="{{ localize 'OQ.Resources.EditTemporaryPoints' }}"
     aria-label="{{ localize 'OQ.Resources.EditTemporaryPoints' }}"><i class="fas fa-layer-group"></i></a>
{{/if}}
