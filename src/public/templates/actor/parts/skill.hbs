<div class="item draggable" data-item-id="{{ id }}">
  <a class="item-to-chat" data-action="itemToChat">
    <img class="item-icon" src="{{img}}" data-tooltip="{{localize 'OQ.Tooltips.SendToChat'}}" alt="{{name}}">
  </a>
  <div class="item-name">
    <a class="item-roll" data-action="rollItem" data-tooltip-html="{{lookup @root.itemTooltips id}}" data-tooltip-direction="LEFT">
      {{name}}
    </a>
    {{#if system.rollValues.mastered}}
      <span data-tooltip="{{localize 'OQ.Labels.SkillMastered'}}"><i class="fa fa-badge-check"></i></span>
    {{/if}}
  </div>
  <input class="item-adv mod-value" type="number" data-dtype="Number"
         value="{{system.advancement}}" data-tooltip="{{ localize 'OQ.Labels.Advances' }}">
  <a class="item-roll total-value" data-action="rollItem"
     data-tooltip="{{localize 'OQ.Labels.Roll'}} {{name}}">{{system.rollValues.value}} {{#if
    system.rollValues.mod}}({{system.rollValues.valueWithMod}}){{/if}} %</a>
  <a class="item-edit" data-action="editItem"><i class="fas fa-edit"></i></a>
  {{#if @root.editable}}
    <a class="item-delete" data-action="deleteItem"><i class="fas fa-trash"></i></a>
  {{/if}}
</div>
