<!-- attributes -->
<div class="attributes flex-col-top">
  <h2 class="flex0">{{ localize 'OQ.Labels.Attributes' }}</h2>

  <div class="attributes-grid">

    <label for="{{rootId}}-hp" class="resource-update" data-action="adjustResource" data-resource-id="hp"
           data-tooltip="{{ localize attributes.hp.label}}">{{ localize attributes.hp.abbr}}</label>
    <div class="value">
      <input id="{{rootId}}-hp" type="number" data-dtype="Number" name="system.attributes.hp.value"
             value="{{system.attributes.hp.value}}">
      <div>&nbsp;/&nbsp{{system.attributes.hp.max}}</div>
    </div>

    <label for="{{rootId}}-mp" class="resource-update" data-action="adjustResource" data-resource-id="mp"
           data-tooltip="{{ localize attributes.mp.label}}">{{ localize attributes.mp.abbr}}</label>
    <div class="value">
      <input id="{{rootId}}-mp" type="number" data-dtype="Number" name="system.attributes.mp.value"
             value="{{system.attributes.mp.value}}">
      <div>&nbsp;/&nbsp{{system.attributes.mp.max}}</div>
    </div>

    {{#if editable}}
      <a class="modify-attributes" data-action="modifyAttributes"
         data-tooltip="{{ localize 'OQ.Labels.EditAttributes' }}"><i class="fas fa-gear"></i></a>
    {{/if}}


    <div class="wide">
      <label data-tooltip="{{ localize attributes.dm.label}}">{{ localize
        attributes.dm.abbr}}</label>
      <div class="value">{{system.attributes.dm.value}}</div>

      <label data-tooltip="{{ localize attributes.mr.label}}">{{ localize
        attributes.mr.abbr}}</label>
      <div class="value">{{system.attributes.mr.value}}</div>

      <label data-tooltip="{{ localize attributes.ap.label}}">{{ localize
        attributes.ap.abbr}}</label>
      <div class="value">{{system.attributes.ap.value}}</div>
    </div>



    {{#if isCharacter}}
      <label for="{{rootId}}-fp" data-tooltip="{{ localize attributes.fn.label }}">{{ localize
        attributes.fn.abbr }}</label>
      <div class="value"><input id="{{rootId}}-fp" type="number" name="system.attributes.fn.value"
                                value="{{system.attributes.fn.value}}">
      </div>
      <label for="{{rootId}}-gp" data-tooltip="{{ localize attributes.gr.label }}">{{ localize
        attributes.gr.abbr }}</label>
      <div class="value"><input id="{{rootId}}-gp" type="number" name="system.attributes.gr.value"
                                value="{{system.attributes.gr.value}}">
      </div>
    {{/if}}


  </div>

</div>
