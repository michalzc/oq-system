<div class="item draggable" data-item-id="{{ id }}">
  <a class="item-to-chat" data-action="itemToChat">
    <img class="item-icon" src="{{img}}" data-tooltip="{{localize 'OQ.Tooltips.SendToChat'}}" alt="{{name}}">
  </a>
  <div class="item-roll" data-tooltip-html="{{lookup @root.itemTooltips id}}" data-tooltip-direction="LEFT">{{name}}</div>

  {{#unless (eq system.type 'single')}}
    <div class="item-quantity">
      {{#if @root.editable}}
        <a class="item-quantity-update" data-action="changeQuantity" data-value="-1"><i class="fas fa-minus"></i></a>
      {{/if}}
      <input type="number" class="item-quantity-value" value="{{ system.quantity }}"
             data-tooltip="{{ localize 'OQ.Labels.Quantity' }}">
      {{#if @root.editable}}
        <a class="item-quantity-update" data-action="changeQuantity" data-value="1"><i class="fas fa-plus"></i></a>
      {{/if}}
    </div>
  {{/unless}}

  {{#if showEq}}
    <a class="item-state item-state-equipment"
       data-tooltip="{{ localize (concat 'OQ.Labels.ItemStates.' system.state) }}">
      {{itemState system.state}}
    </a>
    <div class="cost-value" data-tooltip="{{ localize 'OQ.Labels.Cost' }}"> {{ consolidateFlat system.cost }}</div>
    <div class="short-value" data-tooltip="{{ localize 'OQ.Labels.Encumbrance' }}">
      {{#unless system.totalEncumbrance}}
        {{ system.encumberance }}
      {{/unless}}
      {{#if system.totalEncumbrance}}
        {{ formatNumber system.totalEncumbrance decimals=1 }}
      {{/if}}
    </div>
  {{/if}}
  <a class="item-edit" data-action="editItem"><i class="fas fa-edit"></i></a>
  {{#if @root.editable}}
    <a class="item-delete" data-action="deleteItem"><i class="fas fa-trash"></i></a>
  {{/if}}
</div>
