<div class="two-columns">
  <div class="items">
    <div class="item-group">
      <div class="item label">
        <div>{{ localize 'OQ.SkillTypes.magic'}}</div>
        {{#if @root.editable}}
          <a class="add-new-item" data-action="addItem" data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize 'OQ.SkillTypes.magic' }}"
             data-type="skill" data-system-type="magic"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#each groupedItems.groupedSkills.magic as |skill|}}
        {{> systems/oq/templates/actor/parts/skill.hbs skill}}
      {{/each}}
    </div>
    <div class="item-group">
      <div class="item label">
        <div>{{ localize 'OQ.SkillTypes.resistance'}}</div>
        {{#if @root.editable}}
          <a class="add-new-item" data-action="addItem"
             data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize 'OQ.SkillTypes.resistance' }}" data-type="skill"
             data-system-type="resistance"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#each groupedItems.groupedSkills.resistance as |skill|}}
        {{> systems/oq/templates/actor/parts/skill.hbs skill}}
      {{/each}}
    </div>

    <div class="item-group">
      <div class="item label">
        <div>{{ localize 'OQ.Labels.Abilities'}}</div>
        {{#if @root.editable}}
          <a class="add-new-item" data-action="addItem"
             data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize 'TYPES.Item.specialAbility' }}"
             data-type="specialAbility" data-system-type="magic"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#each groupedItems.magicAbilities as |ability|}}
        {{> systems/oq/templates/actor/parts/ability.hbs ability}}
      {{/each}}
    </div>
  </div>
  <div class="items">
    {{#each spellTypes as |spellType|}}
      <div class="item-group">
        <div class="item label">
          <div>{{ localize (concat 'OQ.Labels.SpellTypes.' spellType) }} {{localize 'OQ.Labels.Spells'}}</div>
          {{#if @root.editable}}
            {{#if (propertyByName @root.spentSpellTypes spellType)}}
              <a class="regain-all-spells" data-action="regainAllSpells" data-spell-type="{{spellType}}"
                 data-tooltip="{{ localize 'OQ.Labels.RegainAll' }}"><i class="fas fa-rotate-left"></i></a>
            {{/if}}
            <a class="add-new-item" data-action="addItem" data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize
              (concat 'OQ.Labels.SpellTypes.' spellType) }} {{localize 'OQ.Labels.Spells'}}" data-type="spell"
               data-system-type="{{spellType}}"><i class="fas fa-plus"></i></a>
          {{/if}}
        </div>
        {{#each (propertyByName ../groupedItems.spellsPerType spellType) as |spell|}}
          {{> systems/oq/templates/actor/parts/spell.hbs spell}}
        {{/each}}
      </div>
    {{/each}}
    {{#each groupedItems.customSpellGroups as |spellGroup|}}
      <div class="item-group">
        <div class="item label">
          <div>{{ localize spellGroup.label }}</div>
          {{#if @root.editable}}
            {{#if spellGroup.spent}}
              <a class="regain-all-spells" data-action="regainAllSpells" data-spell-type="{{spellGroup.type}}"
                 data-custom-type-name="{{spellGroup.customTypeName}}"
                 data-tooltip="{{ localize 'OQ.Labels.RegainAll' }}"><i class="fas fa-rotate-left"></i></a>
            {{/if}}
            <a class="add-new-item" data-action="addItem"
               data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize spellGroup.label }}" data-type="spell"
               data-system-type="{{spellGroup.type}}" data-custom-type-name="{{spellGroup.customTypeName}}"><i
              class="fas fa-plus"></i></a>
          {{/if}}
        </div>
        {{#each spellGroup.spells as |spell|}}
          {{> systems/oq/templates/actor/parts/spell.hbs spell}}
        {{/each}}
      </div>
    {{/each}}
  </div>
</div>
