<div class="two-columns">
  <div class="items skills">
    {{#each groupedItems.skillsTabContent.left as |skillGroup|}}
      <div class="item-group">
        <div class="item label">
          <div>{{ localize skillGroup.label }}{{#if skillGroup.totalAdvancements}} ({{skillGroup.totalAdvancements}}){{/if}}</div>
          {{#if @root.editable}}
            <a class="add-new-item" data-action="addItem" data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize skillGroup.label }}"
               data-type="skill" data-system-type="{{ skillGroup.type }}" data-custom-type-name="{{ skillGroup.label }}">
              <i class="fas fa-plus"></i></a>
          {{/if}}
        </div>
        {{#each skillGroup.skills as |skill|}}
          {{> systems/oq/templates/actor/parts/skill.hbs skill}}
        {{/each}}
      </div>
    {{/each}}
  </div>
  <div class="items skills">

    {{#each groupedItems.skillsTabContent.right as |skillGroup|}}
      <div class="item-group">
        <div class="item label">
          <div>{{ localize skillGroup.label }}{{#if skillGroup.totalAdvancements}} ({{skillGroup.totalAdvancements}}){{/if}}</div>
          {{#if @root.editable}}
            <a class="add-new-item" data-action="addItem" data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize skillGroup.label }}"
               data-type="skill" data-system-type="{{ skillGroup.type }}" data-custom-type-name="{{ skillGroup.label }}">
              <i class="fas fa-plus"></i></a>
          {{/if}}
        </div>
        {{#each skillGroup.skills as |skill|}}
          {{> systems/oq/templates/actor/parts/skill.hbs skill}}
        {{/each}}
      </div>
    {{/each}}

    <div class="item-group">
      <div class="item label">
        <div>{{ localize 'OQ.Labels.SpecialAbilities'}}</div>
        {{#if @root.editable}}
          <a class="add-new-item" data-action="addItem"
             data-tooltip="{{ localize 'OQ.Labels.AddNew' }} {{ localize 'TYPES.Item.specialAbility' }}"
             data-type="specialAbility" data-system-type="general"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#each groupedItems.abilities as |ability|}}
        {{> systems/oq/templates/actor/parts/ability.hbs ability}}
      {{/each}}
    </div>
  </div>
</div>
