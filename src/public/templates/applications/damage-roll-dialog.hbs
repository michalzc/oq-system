<div class="roll-dialog {{type}}">
  <div class="dialog-header">
    <h1>{{ entityName }}</h1>
  </div>
  <div class="dialog-body">
    <div class="roll-info">
      <label>{{ localize 'OQ.Labels.Damage' }}</label>
      <div>{{ damageFormula }}</div>

      {{#if includeDM}}
      <label>{{ localize 'OQ.Labels.DamageMod' }}</label>
      <div>{{ actorRollData.dm }}</div>
      {{/if}}
    </div>
    <div class="roll-params">
      <label for="{{rootId}}-customFormula">{{ localize 'OQ.Dialog.CustomFormula' }}</label>
      <input id="{{rootId}}-customFormula" type="text" data-dtype="String" name="customFormula" class="custom-formula"
             value="{{customFormula}}" autofocus>

      <label for="{{rootId}}-messageMode">{{ localize 'OQ.Dialog.MessageMode' }}</label>
      <select name="messageMode" id="{{rootId}}-messageMode">
        {{selectOptions messageModes selected=messageMode localize=true }}
      </select>
    </div>
  </div>
</div>
