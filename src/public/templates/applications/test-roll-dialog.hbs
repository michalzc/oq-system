<div class="roll-dialog {{type}}">
  <div class="dialog-header">
    <h1>{{ entityName }}</h1>
    {{#if skillName}}
      <h2>{{ skillName }}</h2>
    {{/if}}
  </div>
  <div class="dialog-body">
    <div class="roll-params">
      <label>{{ localize 'OQ.Labels.Value' }}</label>
      <div>{{ value }}</div>

      <label for="{{rootId}}-difficulty">{{localize 'OQ.Labels.Difficulty'}}</label>
      <select name="difficulty" id="{{rootId}}-difficulty">
        {{selectOptions difficulties selected=defaultDifficulty localize=false }}
      </select>
      <label for="{{rootId}}-modifier">{{ localize 'OQ.Labels.OtherMods' }}</label>
      <input type="number" data-dtype="Number" name="mod" id="{{rootId}}-modifier" value="{{mod}}" autofocus>

      <label for="{{rootId}}-messageMode">{{ localize 'OQ.Dialog.MessageMode' }}</label>
      <select name="messageMode" id="{{rootId}}-messageMode">
        {{selectOptions messageModes selected=messageMode localize=true }}
      </select>
    </div>
  </div>
</div>
