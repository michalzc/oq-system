<div class="actor-dialog {{actor.type}} dialog-characteristics">
  <header class="dialog-header">
    <h1>{{actor.name}}</h1>
  </header>

  <section class="dialog-body">
    <h2>{{localize 'OQ.Dialog.Points'}}</h2>
    <div class="points">
      <div class="flex-row-no-wrap">
        <label>{{ localize 'OQ.Dialog.SpentPoints' }}</label>
        <div class="spent-points">{{points.spent}}</div>
      </div>
      <div class="flex-row-no-wrap">
        <label>{{ localize 'OQ.Dialog.RemainPoints' }}</label>
        <div class="remain-points">{{points.remain}}</div>
      </div>
      <div class="flex-row-no-wrap">
        <label for="{{rootId}}-all-points">{{localize 'OQ.Dialog.AllPoints' }}</label>
        <input type="number" data-dtype="Number" id="{{rootId}}-all-points" class="all-points" value="{{points.all}}">
      </div>
    </div>
    <h2>{{localize 'OQ.Labels.Characteristics' }}</h2>
    <div class="chars-table">
      <label></label>
      <label>{{localize 'OQ.Dialog.Base'}}</label>
      <a class="roll-all" data-action="rollAllCharacteristics" data-tooltip="{{ localize 'OQ.Dialog.Roll All'}}"><i
        class="fas fa-dice"></i></a>
      <label>{{localize 'OQ.Dialog.Roll'}}</label>
      <label>{{localize 'OQ.Dialog.Mod'}}</label>
      {{#each characteristics as |char key|}}
        <label for="{{@root.rootId}}-char-{{key}}-base" data-tooltip="{{ localize char.label }}">{{ localize char.abbr }}</label>
        <input type="number" class="characteristic-base-input" data-dtype="Number" id="{{@root.rootId}}-char-{{key}}-base"
               name="system.characteristics.{{key}}.base" value="{{char.base}}">

        <a class="roll-characteristic self-center" data-action="rollCharacteristic" data-key="{{key}}"
           data-tooltip="{{ localize 'OQ.Dialog.Roll' }} {{ localize char.label }}"><i class="fas fa-dice-two"></i></a>
        <input type="text" data-dtype="String" name="system.characteristics.{{key}}.roll" value="{{char.roll}}">

        <input type="number" data-dtype="Number" name="system.characteristics.{{key}}.mod" value="{{char.mod}}">


      {{/each}}
    </div>
  </section>
  <section class="dialog-body">
    <div class="flexrow">
      <button type="submit"><i class="fas fa-save"></i> {{ localize 'OQ.Dialog.Save' }} </button>
      <button type="button" class="reset" data-action="resetForm"><i class="fas fa-cancel"></i> {{ localize 'OQ.Dialog.Reset' }} </button>
    </div>
  </section>
</div>
