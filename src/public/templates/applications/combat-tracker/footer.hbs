<nav class="combat-controls" data-tooltip-direction="UP">
    {{#if hasCombat}}
    {{#if user.isGM}}
    {{#if declaration}}
    <button type="button" class="combat-control combat-control-lg" data-action="startRound" {{#unless canStartRound}}disabled{{/unless}}>
        <i class="fa-solid fa-swords" inert></i><span>{{localize "OQ.Combat.StartRound"}}</span>
    </button>
    <button type="button" class="inline-control combat-control icon fa-solid fa-xmark" data-action="endCombat" data-tooltip aria-label="{{localize "COMBAT.End"}}"></button>
    {{else}}
    <button type="button" class="inline-control combat-control icon fa-solid fa-arrow-left" data-action="previousTurn" {{#unless canPreviousTurn}}disabled{{/unless}} data-tooltip aria-label="{{localize "COMBAT.TurnPrev"}}"></button>
    <button type="button" class="combat-control combat-control-lg" data-action="endCombat"><i class="fa-solid fa-xmark" inert></i><span>{{localize "COMBAT.End"}}</span></button>
    <button type="button" class="inline-control combat-control icon fa-solid fa-arrow-right" data-action="nextTurn" data-tooltip aria-label="{{localize "COMBAT.TurnNext"}}"></button>
    <button type="button" class="inline-control combat-control icon fa-solid fa-forward-step" data-action="nextRound" data-tooltip aria-label="{{localize "COMBAT.RoundNext"}}"></button>
    {{/if}}
    {{else if control}}
    <button type="button" class="inline-control combat-control icon fa-solid fa-arrow-left" data-action="previousTurn" {{#unless canPreviousTurn}}disabled{{/unless}} data-tooltip aria-label="{{localize "COMBAT.TurnPrev"}}"></button>
    <button type="button" class="combat-control combat-control-lg" data-action="nextTurn"><i class="fa-solid fa-check" inert></i><span>{{localize "COMBAT.TurnEnd"}}</span></button>
    {{/if}}
    {{/if}}
</nav>
