<ol class="combat-tracker plain">
    {{#each turns}}
    <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant" data-encounter-id="{{encounterId}}" data-declaration-round="{{declarationRound}}">
        {{!-- TODO: Targets --}}

        {{!-- Image --}}
        <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

        {{!-- Name & Controls --}}
        <div class="token-name">
            <strong class="name">{{ name }}</strong>
            {{#unless declaration}}<div class="initiative-name">{{#if awaiting}}{{localize "OQ.Combat.Awaiting"}}{{else}}{{actionName}} <span class="declaration-mod">({{signedMod}})</span>{{/if}}</div>{{/unless}}
            <div class="combatant-controls">
                {{#if @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip aria-label="{{ localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide") }}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip
                        aria-label="{{ localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated") }}"></button>
                {{/if}}
                {{#if canPing}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                        data-action="pingCombatant" data-tooltip
                        aria-label="{{ localize "COMBATANT.Ping" }}"></button>
                {{/if}}
                {{#unless @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                        data-action="panToCombatant" data-tooltip
                        aria-label="{{ localize "COMBATANT.PanTo" }}"></button>
                {{/unless}}
                {{!-- TODO: Target Control --}}
                <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                    {{#each effects.icons}}
                    <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                    {{/each}}
                </div>
            </div>
        </div>

        {{!-- Resource --}}
        {{#if resource includeZero=true}}
        <div class="token-resource">
            <span class="resource">{{ resource }}</span>
        </div>
        {{/if}}

        <div class="token-initiative">
            {{#unless awaiting}}<span class="initiative" aria-label="{{localize "OQ.Labels.Initiative"}}">{{initiative}}</span>{{/unless}}
        </div>
        {{#if declaration}}
        <div class="oq-declaration">
            {{#if declarationEditable}}
            <select data-declaration-field="reference" aria-label="{{localize "OQ.Combat.Action"}}">
                {{selectOptions initiativeOptions selected=reference blank=(localize "OQ.Combat.NoAction") sort=true}}
            </select>
            <input type="text" inputmode="numeric" pattern="[+-]?[0-9]+" class="oq-declaration-mod"
                   data-declaration-field="mod" value="{{signedMod}}" aria-label="{{localize "OQ.Combat.Modifier"}}">
            {{else if actorless}}
            <select disabled aria-label="{{localize "OQ.Combat.Action"}}"><option>{{localize "OQ.Combat.NoAction"}}</option></select>
            <input type="text" class="oq-declaration-mod" value="0" disabled aria-label="{{localize "OQ.Combat.Modifier"}}">
            {{else}}
            <span class="initiative-name">{{actionName}}</span><span>{{signedMod}}</span>
            {{/if}}
        </div>
        {{/if}}
    </li>
    {{/each}}
</ol>
