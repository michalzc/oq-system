<div class="item-sheet flexcol">
  <header class="sheet-header flex0">
    <img class="profile-img" src="{{item.img}}" {{#if editable}}data-action="editImage"{{/if}} data-edit="img" title="{{item.name}}" width="64" height="64"
         alt="{{item.name}}">
    <div class="flexcol">
      <input class="name" type="text" data-dtype="String" name="name" value="{{item.name}}"
             placeholder="{{localize 'OQ.Labels.Name'}}">
      {{#if system.slug }}
        <span class="short-name">{{system.slug}}</span>
      {{/if}}
    </div>
  </header>

  <section class="sheet-content">
    {{ getPartial this.item.type this }}
    <fieldset class="description-container">
      <legend>{{localize 'OQ.Labels.Description'}}</legend>
      <prose-mirror name="system.description" value="{{system.description}}" toggled
                    data-document-uuid="{{item.uuid}}" {{#unless editable}}disabled{{/unless}}>
        {{{enrichedDescription}}}
      </prose-mirror>
    </fieldset>

  </section>
</div>
