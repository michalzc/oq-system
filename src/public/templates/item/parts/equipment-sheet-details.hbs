<div class="item-details">
  <label for="{{rootId}}-encumbrance">{{localize 'OQ.Labels.Encumbrance'}}</label>
  <input id="{{rootId}}-encumbrance" type="number" data-dtype="Number" name="system.encumbrance" value="{{ system.encumbrance }}">

  <label for="{{rootId}}-cost">{{localize 'OQ.Labels.Cost'}}</label>
  <input id="{{rootId}}-cost" type="number" data-dtype="Number" name="system.cost" value="{{ system.cost }}">

  <label for="{{rootId}}-type">{{localize 'OQ.Labels.Type'}}</label>
  <select id="{{rootId}}-type" name="system.type">
    {{selectOptions itemTypes selected=system.type localize=true }}
  </select>

  {{#unless (eq system.type 'single')}}
    <label for="{{rootId}}-quantity">{{localize 'OQ.Labels.Quantity' }}</label>
    <input type="number" id="{{rootId}}-quantity" data-dtype="Number" name="system.quantity" value="{{ system.quantity }}">
  {{/unless}}

  <label for="{{rootId}}-itemState">{{localize 'OQ.Labels.State'}}</label>
  <select id="{{rootId}}-itemState" name="system.state">
    {{selectOptions itemStates selected=system.state localize=true }}
  </select>

  {{> systems/oq/templates/item/parts/traits.hbs }}

</div>
