<div class="item-details">
  <label for="{{rootId}}-type">{{ localize 'OQ.Labels.Type' }}</label>
  <select id="{{rootId}}-type" name="system.type">
    {{ selectOptions specialAbilityTypes selected=system.type localize=true }}
  </select>

  <label for="{{rootId}}-formula">{{ localize 'OQ.Labels.Formula' }}</label>
  <input type="text" id="{{rootId}}-formula" data-dtype="String" name="system.formula" value="{{ system.formula }}">

  <label for="{{rootId}}-damageFormula">{{ localize 'OQ.Labels.DamageFormula' }}</label>
  <input type="text" id="{{rootId}}-damageFormula" data-dtype="String" name="system.damageFormula" value="{{ system.damageFormula }}">

  {{> systems/oq/templates/item/parts/traits.hbs }}
</div>
