<div class="item-details">
  <label for="{{rootId}}-type">{{localize 'OQ.Labels.Type'}}</label>

  <select name="system.type" id="{{rootId}}-type">
    {{selectOptions skillTypes selected=system.type localize=true}}
  </select>
  {{#if customType}}
    <label for="{{rootId}}-customType">{{localize 'OQ.Labels.CustomType'}}</label>
    <input type="text" name="system.customTypeName" id="{{rootId}}-customType" value="{{system.customTypeName}}">
  {{/if}}
  <label for="{{rootId}}-formula">{{localize 'OQ.Labels.Formula'}}</label>
  <input type="text" name="system.formula" id="{{rootId}}-formula" value="{{system.formula}}">
  {{#if assigned}}
    <label for="{{rootId}}-advancement">{{ localize 'OQ.Labels.Advances' }}</label>
    <input type="number" data-dtype="Number" id="{{rootId}}-advancement" name="system.advancement" value="{{ system.advancement }}">

    <label for="{{rootId}}-mod">{{localize 'OQ.Labels.Mod'}}</label>
    <input type="number" name="system.mod" id="{{rootId}}-mod" value="{{system.mod}}">

    <label>{{ localize 'OQ.Labels.TotalValue' }}</label>
    <div>{{ system.rollValues.value }}</div>
  {{/if}}

</div>
